// Hafnium's default fastfetch config, installed to /etc/xdg/fastfetch/config.jsonc.
// Override it per user with ~/.config/fastfetch/config.jsonc
// (`fastfetch --gen-config` writes a full one to start from).
// Colours are terminal palette names, so they follow your DMS/Flexoki theme.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "fedora",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "blue" },
    "key": { "width": 12 }
  },
  "modules": [
    "break",
    "title",
    "separator",
    "os",
    {
      "type": "command",
      "key": "Hafnium",
      "text": "rpm -q --qf '%{VERSION}, build %{RELEASE}' hafnium 2>/dev/null | sed -E 's/\\.git([0-9a-f]+)\\.fc[0-9]+$/ (\\1)/' || echo 'not installed'"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    {
      "type": "command",
      "key": "Shell UI",
      "text": "printf 'DMS %s' \"$(rpm -q --qf '%{VERSION}' dms 2>/dev/null)\""
    },
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
