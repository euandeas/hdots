input {
    keyboard {
        // Empty xkb: niri reads the layout from org.freedesktop.locale1,
        // so the keyboard picked in the installer just works.
        // Change it with: localectl set-x11-keymap <layout>
        xkb {}
        numlock
    }

    // Mouse and touchpad live in DMS (Settings -> Mouse & Touchpad), which writes
    // ~/.config/niri/dms/input.kdl on every start. niri doesn't merge mouse/touchpad
    // sections across files, so anything set here would be replaced by that file.
    // Kansora's defaults (flat mouse acceleration, clickfinger) are in DMS's settings.json.
}
