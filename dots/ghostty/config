# Ghostty, Hafnium's default terminal.
# Hafnium copied this file once and will never overwrite it. Edit freely.
# Reference: https://ghostty.org/docs/config/reference
# Restore the default: hafnium-dots reset ~/.config/ghostty/config

# Font: Commit Mono, Hafnium's monospace font
font-family = "CommitMono Nerd Font Mono"
font-size = 12

# Window
window-decoration = false
window-padding-x = 12
window-padding-y = 12
gtk-titlebar = false
gtk-single-instance = true
confirm-close-surface = false
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# Cursor
cursor-style = block
cursor-style-blink = true

# Behaviour
mouse-hide-while-typing = true
copy-on-select = false
app-notifications = no-clipboard-copy,no-config-reload
shell-integration = detect
# no-cursor: keep the block cursor instead of letting the shell switch it to a bar
shell-integration-features = sudo,title,no-cursor

# Keys
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = shift+enter=text:\n

# Colours that follow your wallpaper. DMS writes this theme with matugen.
# The leading "?" means Ghostty starts fine before the file exists.
config-file = ?themes/dankcolors
