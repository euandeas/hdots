# Ghostty, Hafnium's default terminal.
# Hafnium copied this file once and will never overwrite it. Edit freely.
# Reference: https://ghostty.org/docs/config/reference
# Restore the default: hafnium-dots reset ~/.config/ghostty/config

# Window
window-decoration = false
window-padding-x = 12
window-padding-y = 12
gtk-titlebar = false
gtk-single-instance = true
confirm-close-surface = false

# Behaviour
mouse-hide-while-typing = true
copy-on-select = false
app-notifications = no-clipboard-copy,no-config-reload
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Font: Commit Mono, Hafnium's monospace font
font-family = "CommitMono Nerd Font Mono"

# Cursor
cursor-style = block

# Colours that follow your wallpaper. DMS writes this theme with matugen.
# The leading "?" means Ghostty starts fine before the file exists.
config-file = ?themes/dankcolors
